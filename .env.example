# Copy this file to .env and paste your MongoDB Atlas connection string below.
MONGODB_URI=replace-with-your-private-atlas-connection-string
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
HR_REGISTRATION_CODE=set-a-private-code-for-hr-signups
MANAGER_REGISTRATION_CODE=set-a-private-code-for-manager-signups
